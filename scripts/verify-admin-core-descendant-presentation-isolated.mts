 assertOwnedLocalHandle(handle);assert.equal(states.has(handle),false);const plan=await loadCoreDescendantPresentationPlan(scope) as Spec[],namespace='qa-descendant-'+createHash('sha256').update(handle.identity.runId).digest('hex').slice(0,12);
