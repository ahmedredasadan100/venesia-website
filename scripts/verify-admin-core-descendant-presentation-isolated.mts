   assert.equal((await connection.query('select count(*)::int count from public.menus where slug like $1',[namespace+'%'])).rows[0].count,0);
   const menus=(await connection.query("insert into public.menus(name,slug,location,is_active) select $1||' Name '||lpad(n::text,2,'0'),$1||'-'||n,'custom',n%2=0 from generate_series(1,$2::int)n returning id,name",[namespace+'-menus',rowCount])).rows;assert.equal(menus.length,rowCount);current.fixtures.menus={search:namespace+'-menus',ids:menus.map(row=>String(row.id)).sort((a,b)=>Number(a)-Number(b)),route:'/admin/pages-blocks/menus'};
