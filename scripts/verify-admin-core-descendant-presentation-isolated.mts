export function validateCoreDescendantPresentationRequest(input:unknown){assert.ok(input&&typeof input==='object'&&!Array.isArray(input));const row=input as Row;assert.deepEqual(Object.keys(row).sort(),['id','key','kind','phase']);assert.match(String(row.id),/^[a-f0-9]{8}-[a-f0-9]{4}-[1-8][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$/i);assert.equal(row.kind,'descendant-presentation-state');assert.ok(['menus','items','assignments','footer'].includes(String(row.key)));assert.ok(['before','hidden','restored','after'].includes(String(row.phase)));return row as {id:string;key:string;kind:string;phase:string};}

/** Opt in BEFORE the pre-existing navigation fixture captures its baseline.
