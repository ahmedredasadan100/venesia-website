   const templates=(await connection.query("insert into public.content_block_templates(name,slug,status,config,variant,sort_order) select $2||' Template '||lpad(n::text,2,'0'),$2||'-'||n,'published',source.config,source.variant,n from public.content_block_templates source cross join generate_series(1,$3::int)n where source.id=$1 returning id,sort_order",[source.id,namespace+'-assignments',rowCount])).rows;assert.equal(templates.length,rowCount);
   for(const template of templates)await connection.query("select public.mutate_page_composition($1,'save_assignment',$2::jsonb,null,$3)",[pageId,JSON.stringify({kind:'content',template_id:Number(template.id),slot:'main',sort_order:Number(template.sort_order),is_visible:true}),'system:'+namespace]);
   const assignments=(await connection.query("select id from public.page_composition_assignments where page_id=$1 and kind='content' order by sort_order,id",[pageId])).rows;assert.equal(assignments.length,rowCount);current.fixtures.assignments={search:namespace+'-assignments',ids:assignments.map(row=>'content:'+row.id),route:'/admin/pages-blocks/pages/'+pageId,tab:'modules'};
  }
