type Row=Record<string,unknown>;
type Spec={key:string;scope:string;consumer:string;aliases:string[];route:string;preferenceId:string|null;viewKey:string|null;defaults:string[];rowCount:number;pageSize:number;paginationMode:string;optional:string|null;label:string|null;columns:Array<{key:string;label:string;hideable:boolean}>};
