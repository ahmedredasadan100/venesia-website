   assert.deepEqual(values.map(row=>row.key).sort(),[...FOOTER_SETTING_KEYS].sort());const value=(key:string)=>values.find(row=>row.key===key)?.value;assert.equal(evaluateFooterReadiness({slots:value('footer.slots'),contactItems:value('footer.contact_items'),socialLinks:value('footer.social_links'),legal:value('footer.legal')}).systemValid,true);
   const actor=(await connection.query('select username from public.admin_users where id=$1',[current.actorId])).rows[0];await connection.query("select public.save_footer_settings($1::jsonb,$2,$3,'qa.descendant.presentation.prepare','{}'::jsonb)",[JSON.stringify(values),current.actorId,String(actor.username)]);
