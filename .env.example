# Copy to .env.local — never commit real secrets.

# Supabase (existing)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# CMS uploads use Supabase Storage automatically in Production and Vercel Preview.
# Local development can opt into the same provider with CMS_STORAGE_UPLOADS=supabase;
# otherwise local development may use public/ only for backwards-compatible testing.
CMS_STORAGE_UPLOADS=supabase
# Optional only when the deployment intentionally uses non-default bucket names.
# SUPABASE_STORAGE_BUCKET_IMAGES=cms-images
# SUPABASE_STORAGE_BUCKET_DOCUMENTS=cms-documents

# Admin session signing secret (required in production) — NOT a login password
ADMIN_SESSION_SECRET=

# External Integrations Capability runtime controls (server-only; never use NEXT_PUBLIC_).
# OAuth callback origins come from the canonical SEO/domain owner, never from request Host.
INTEGRATIONS_ENVIRONMENT_KEY=production
CRON_SECRET=

# Legacy bootstrap only: import these once through CMS Server Configuration into
# Supabase Vault. When a CMS owner exists it is authoritative and these values
# are not merged or read as a second source of truth.
GOOGLE_INTEGRATIONS_CLIENT_ID=
GOOGLE_INTEGRATIONS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
# Pin against the official Google Ads API release schedule; current implementation default is v25.
GOOGLE_ADS_API_VERSION=v25

META_APP_ID=
META_APP_SECRET=
# Explicit pin is required. Example only; choose an active Graph API version in Meta App settings.
META_GRAPH_API_VERSION=

TIKTOK_BUSINESS_APP_ID=
TIKTOK_BUSINESS_APP_SECRET=

SNAPCHAT_MARKETING_CLIENT_ID=
SNAPCHAT_MARKETING_CLIENT_SECRET=

# Public canonical URL (used for production cookie domain across www/apex)
NEXT_PUBLIC_SITE_URL=https://www.venesia-developments.net

# Optional per-field Global SEO environment layer. Database values take precedence;
# unset values fall through to code defaults. Never copy fallback values into Admin as persisted.
# SEO_CANONICAL_BASE_URL=https://www.venesia-developments.net
# SEO_SITE_NAME=Venesia Developments
# SEO_DEFAULT_TITLE=
# SEO_DEFAULT_DESCRIPTION=
# SEO_DEFAULT_OG_IMAGE=
# SEO_DEFAULT_OG_IMAGE_ALT=
# SEO_DEFAULT_TWITTER_IMAGE=
# SEO_DEFAULT_ROBOTS_INDEX=true
# SEO_DEFAULT_ROBOTS_FOLLOW=true
# SEO_ORGANIZATION_NAME=
# SEO_ORGANIZATION_ALTERNATE_NAME=
# SEO_ORGANIZATION_LEGAL_NAME=
# SEO_ORGANIZATION_TAGLINE=
# SEO_ORGANIZATION_DESCRIPTION=
# SEO_ORGANIZATION_LOGO=
# SEO_ORGANIZATION_PHONE=
# SEO_ORGANIZATION_EMAIL=
# SEO_ORGANIZATION_STREET_ADDRESS=
# SEO_ORGANIZATION_ADDRESS_LOCALITY=
# SEO_ORGANIZATION_ADDRESS_REGION=
# SEO_ORGANIZATION_POSTAL_CODE=
# SEO_ORGANIZATION_ADDRESS_COUNTRY=
# SEO_ORGANIZATION_AREA_SERVED=
# SEO_ORGANIZATION_KNOWS_ABOUT=
# SEO_ORGANIZATION_SOCIAL_LINKS_JSON=[]
# SEO_TWITTER_HANDLE=
# SEO_GOOGLE_SITE_VERIFICATION=
# SEO_BING_SITE_VERIFICATION=
# SEO_ROBOTS_TXT_ALLOW=/
# SEO_ROBOTS_TXT_DISALLOW=/api/,/_next/,/admin/,/maintenance/,/dashboard/,/private/

# Cookie Secure: auto true on HTTPS/Vercel, false on local http. Override: ADMIN_SESSION_COOKIE_SECURE=true|false
# Cookie domain override (optional): ADMIN_SESSION_COOKIE_DOMAIN=.example.com or none

# After changing env on Vercel/VPS: full Redeploy + restart process (env is loaded at build/start only).

# Optional: allow projects-data.ts reimport outside development
# ALLOW_PROJECTS_STATIC_REIMPORT=true

# Public Media editorial truth is database-owned by topics; there is no environment source selector.
