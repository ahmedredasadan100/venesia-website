# Copy to .env.local — never commit real secrets.

# Supabase (existing)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# CMS uploads use Supabase Storage automatically in Production and Vercel Preview.
# Local development can opt into the same provider with CMS_STORAGE_UPLOADS=supabase;
# otherwise local development may use public/ only for backwards-compatible testing.
CMS_STORAGE_UPLOADS=supabase
# Optional only when the deployment intentionally uses non-default bucket names.
# SUPABASE_STORAGE_BUCKET_IMAGES=cms-images
# SUPABASE_STORAGE_BUCKET_DOCUMENTS=cms-documents

# Admin session signing secret (required in production) — NOT a login password
ADMIN_SESSION_SECRET=

# Public canonical URL (used for production cookie domain across www/apex)
NEXT_PUBLIC_SITE_URL=https://www.venesiadevelopments.com

# Cookie Secure: auto true on HTTPS/Vercel, false on local http. Override: ADMIN_SESSION_COOKIE_SECURE=true|false
# Cookie domain override (optional): ADMIN_SESSION_COOKIE_DOMAIN=.example.com or none

# After changing env on Vercel/VPS: full Redeploy + restart process (env is loaded at build/start only).

# Optional: allow projects-data.ts reimport outside development
# ALLOW_PROJECTS_STATIC_REIMPORT=true

# Public media content source: unified (official) | legacy
# Unified Media reads from the topics table (content_type media types).
# Legacy Media reads from media_items — do not enable casually in production.
PUBLIC_MEDIA_CONTENT_SOURCE=unified
# When unified returns no rows, optionally fall back to legacy media_items (disabled by default).
# Enabling this can make Admin-managed Unified Media differ from public output.
PUBLIC_MEDIA_LEGACY_FALLBACK=false
