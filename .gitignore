# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/.auth/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.zip

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local QA / Playwright artifacts (never deploy)
qa-mobile-audit/
**/issue-shots/
**/output-report/
**/output-final/
**/output-focused/
**/*-audit/
lint-errors.txt
lint-report.txt
dead-code-scan*.json
# canonical documentation policy
/.tmp-qa/
/.supabase-local/
/supabase/.temp/
/supabase/.branches/
/supabase/snippets/
/supabase/migrations/
/docs/qa/
/docs/archive/
/docs/*.docx
/responsive-layout-audit.md

